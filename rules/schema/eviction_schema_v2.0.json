{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/andrewmichaelcohen-a2j/a2j-ai/rules/schema/eviction_schema_v2.0.json",
  "title": "Eviction Defense Rules — Schema v2.0",
  "description": "Schema for the Civil Justice as Code eviction-defense rules library. v2 answers: what defenses does this tenant have against this eviction? Five defense modules, each independently statused. file_status = min(module_status). Copyright 2026 Andrew M Cohen. Apache 2.0.",
  "type": "object",
  "required": ["_copyright", "schema_version", "jurisdiction", "provenance", "validation", "notice", "service", "overlays", "substantive_defenses", "procedural_defects"],
  "properties": {
    "_copyright": {
      "type": "string",
      "description": "Copyright notice. Must be: 'Copyright 2026 Andrew M Cohen. Licensed under the Apache License, Version 2.0.'"
    },
    "schema_version": {
      "type": "string",
      "const": "eviction-v2",
      "description": "Schema version identifier. Must be exactly 'eviction-v2'."
    },
    "jurisdiction": {
      "type": "object",
      "required": ["state", "state_name", "type"],
      "properties": {
        "state": { "type": "string", "description": "Two-letter postal abbreviation (e.g., CA) or DC" },
        "state_name": { "type": "string", "description": "Full state name" },
        "type": { "type": "string", "enum": ["state", "district"] }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["generated", "statutory_sources"],
      "properties": {
        "generated": {
          "type": "object",
          "required": ["date", "model", "method"],
          "properties": {
            "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "model": { "type": "string", "description": "AI model used for generation, e.g. claude-sonnet-4-6" },
            "method": { "type": "string", "description": "Generation method, e.g. v1-migration+stub-expansion or full-generation" }
          }
        },
        "statutory_sources": {
          "type": "array",
          "description": "All statutes cited across all modules",
          "items": {
            "type": "object",
            "required": ["cite"],
            "properties": {
              "cite": { "type": "string" },
              "url": { "type": ["string", "null"] },
              "retrieved": { "type": "boolean" },
              "retrieved_date": { "type": ["string", "null"] }
            }
          }
        },
        "per_module_sources": {
          "type": "object",
          "description": "Statute citations organized by module",
          "properties": {
            "notice": { "type": "array", "items": { "type": "string" } },
            "service": { "type": "array", "items": { "type": "string" } },
            "overlays": { "type": "array", "items": { "type": "string" } },
            "substantive_defenses": { "type": "array", "items": { "type": "string" } },
            "procedural_defects": { "type": "array", "items": { "type": "string" } }
          }
        },
        "ai_drafter_notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "validation": {
      "type": "object",
      "required": ["file_status", "module_status", "automated_layers", "coverage_level"],
      "properties": {
        "file_status": {
          "type": "string",
          "enum": ["DRAFT", "AUTOMATED-CHECKS-PASSED", "UNDER REVIEW", "VALIDATED", "CERTIFIED", "NEEDS UPDATE"],
          "description": "DERIVED — always min(module_status). Never set directly. Enforced by validate.py."
        },
        "module_status": {
          "type": "object",
          "required": ["notice", "service", "overlays", "substantive_defenses", "procedural_defects"],
          "properties": {
            "notice": { "$ref": "#/definitions/module_status_entry" },
            "service": { "$ref": "#/definitions/module_status_entry" },
            "overlays": { "$ref": "#/definitions/module_status_entry" },
            "substantive_defenses": { "$ref": "#/definitions/module_status_entry" },
            "procedural_defects": { "$ref": "#/definitions/module_status_entry" }
          }
        },
        "automated_layers": {
          "type": "object",
          "required": ["L1_grounding", "L2_consensus", "L3_consistency", "L4_golden", "L5_crossjuris", "L6_freshness"],
          "properties": {
            "L1_grounding": { "type": "string", "enum": ["pass", "fail", "warning", "not_implemented", "not_run"] },
            "L2_consensus": { "type": "string", "enum": ["pass", "fail", "warning", "not_implemented", "not_run"] },
            "L3_consistency": { "type": "string", "enum": ["pass", "fail", "warning", "not_implemented", "not_run"] },
            "L4_golden": { "type": "string", "enum": ["pass", "fail", "warning", "not_implemented", "not_run"] },
            "L5_crossjuris": { "type": "string", "enum": ["pass", "fail", "warning", "not_implemented", "not_run"] },
            "L6_freshness": { "type": "string", "enum": ["pass", "fail", "warning", "not_implemented", "not_run"] }
          }
        },
        "coverage_level": {
          "type": "string",
          "description": "Comma-separated list of layers applied in last run, e.g. 'L1,L3,L5'. Empty string if no layers run."
        },
        "flags": {
          "type": "array",
          "description": "Warnings and anomalies from the validation battery",
          "items": {
            "type": "object",
            "required": ["layer", "field", "note", "disposition"],
            "properties": {
              "layer": { "type": "string" },
              "field": { "type": "string" },
              "note": { "type": "string" },
              "disposition": {
                "type": "string",
                "enum": ["open", "acknowledged", "resolved"],
                "description": "open = not yet reviewed; acknowledged = known/accepted; resolved = fixed"
              }
            }
          }
        },
        "validation_note": {
          "type": "string",
          "description": "Human-readable summary of validation state"
        }
      }
    },
    "notice": {
      "type": "object",
      "description": "Module 1 — bright-line. Notice types and defects. Absorbs all v1 notice fields.",
      "required": ["notice_types", "notice_defects"],
      "properties": {
        "notice_types": {
          "type": "object",
          "description": "Notice type configurations by reason category",
          "properties": {
            "pay_or_quit": {
              "type": "object",
              "properties": {
                "description": { "type": "string" },
                "permitted_amounts": { "type": "array", "items": { "type": "string" } },
                "late_fees_permitted": { "type": "boolean" },
                "utilities_permitted": { "type": "boolean" },
                "notice_required": {
                  "type": "boolean",
                  "description": "Explicit boolean: false when no statutory notice is required for this ground before filing (e.g., NJ nonpayment — §2A:18-61.2 excludes nonpayment from notice-to-quit requirement). When false, tenancy_all.days should be null. Omit or set true for normal states. Canonical pattern: notice_required=false + exceptions[] for subsidy carve-outs."
                },
                "exceptions": {
                  "type": "array",
                  "description": "Conditions under which notice IS required (or a different period applies) despite notice_required=false. Canonical use: federally-subsidized housing carve-out. This is the library-wide pattern for 'no notice period / subsidy-conditional notice' — see docs/SCHEMA_V2_DESIGN_SPEC.md.",
                  "items": {
                    "type": "object",
                    "properties": {
                      "condition": { "type": "string", "description": "Machine-readable condition identifier, e.g. federally_subsidized_housing" },
                      "notice_required": { "type": "boolean" },
                      "notice_period_days": { "type": ["integer", "null"] },
                      "authority": { "type": "string", "description": "Statutory or regulatory authority for this exception" }
                    }
                  }
                },
                "tenancy_all": { "$ref": "#/definitions/notice_period" },
                "tenancy_under_1yr": { "$ref": "#/definitions/notice_period" },
                "tenancy_over_1yr": { "$ref": "#/definitions/notice_period" }
              }
            },
            "cure_or_quit": {
              "type": "object",
              "properties": {
                "description": { "type": "string" },
                "days": { "type": "integer", "minimum": 1 },
                "statute": { "type": "string" },
                "curable": { "type": "boolean" }
              }
            },
            "quit_only": {
              "type": "object",
              "properties": {
                "description": { "type": "string" },
                "days": { "type": "integer", "minimum": 1 },
                "statute": { "type": "string" }
              }
            },
            "termination": {
              "type": "object",
              "description": "No-fault / end-of-tenancy termination",
              "properties": {
                "statute": { "type": "string" },
                "tenancy_under_1yr": { "$ref": "#/definitions/notice_period" },
                "tenancy_over_1yr": { "$ref": "#/definitions/notice_period" },
                "tenancy_any": { "$ref": "#/definitions/notice_period" },
                "just_cause_required": { "type": "boolean" },
                "just_cause_statute": { "type": ["string", "null"] }
              }
            }
          }
        },
        "notice_defects": {
          "type": "array",
          "description": "Enumerated defects that invalidate a notice",
          "items": {
            "type": "object",
            "required": ["defect", "consequence", "severity"],
            "properties": {
              "defect": { "type": "string" },
              "consequence": { "type": "string", "enum": ["notice_void", "defective_curable", "warning"] },
              "statute": { "type": ["string", "null"] },
              "case_law": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "cite": { "type": "string" },
                    "holding": { "type": "string" }
                  }
                }
              },
              "severity": { "type": "string", "enum": ["void", "defective_curable", "warning"] },
              "note": { "type": ["string", "null"] }
            }
          }
        },
        "notice_period_basis": {
          "type": "object",
          "description": "Tenancy-length triggers that affect which notice period applies",
          "properties": {
            "tenancy_length_matters": { "type": "boolean" },
            "breakpoints": { "type": "array", "items": { "type": "object" } }
          }
        }
      }
    },
    "service": {
      "type": "object",
      "description": "Module 2 — bright-line. How the notice/summons must be served; service defects are independent of notice content.",
      "required": ["permitted_methods", "method_rules", "service_defects"],
      "properties": {
        "permitted_methods": {
          "type": "array",
          "items": { "type": "string", "enum": ["personal", "substituted", "mail", "certified_mail", "posting", "nail_and_mail", "electronic"] }
        },
        "method_rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["method", "requirements", "statute"],
            "properties": {
              "method": { "type": "string" },
              "requirements": { "type": "string" },
              "statute": { "type": "string" },
              "adds_days_for_mail": { "type": ["integer", "null"] },
              "note": { "type": ["string", "null"] }
            }
          }
        },
        "service_defects": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["defect", "consequence"],
            "properties": {
              "defect": { "type": "string" },
              "consequence": { "type": "string" },
              "statute": { "type": ["string", "null"] },
              "case_law": { "type": "array", "items": { "type": "object" } }
            }
          }
        }
      }
    },
    "overlays": {
      "type": "object",
      "description": "Module 3 — bright-line but easy to miss. Federal and local rules that sit on top of state law.",
      "required": ["federal", "state_protective", "local"],
      "properties": {
        "federal": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "applies_when", "effect", "statute"],
            "properties": {
              "name": { "type": "string" },
              "applies_when": { "type": "string" },
              "effect": { "type": "string" },
              "statute": { "type": "string" },
              "status": { "type": "string", "enum": ["active", "expired", "conditional"] }
            }
          }
        },
        "state_protective": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "effect", "statute"],
            "properties": {
              "name": { "type": "string" },
              "effect": { "type": "string" },
              "statute": { "type": "string" }
            }
          }
        },
        "local": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["jurisdiction", "type"],
            "properties": {
              "jurisdiction": { "type": "string" },
              "type": { "type": "string", "enum": ["rent_control", "just_cause", "relocation", "moratorium", "other"] },
              "effect": { "type": "string" },
              "source": { "type": "string" },
              "digitization_note": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "substantive_defenses": {
      "type": "array",
      "description": "Module 4 — case-law-dependent / open-textured. Defenses that determine outcomes but resist mechanical encoding.",
      "items": {
        "type": "object",
        "required": ["defense", "elements", "openness", "review_weight"],
        "properties": {
          "defense": { "type": "string", "enum": ["retaliation", "habitability_warranty", "discrimination", "breach_of_quiet_enjoyment", "improper_rent_calculation", "other"] },
          "elements": { "type": "array", "items": { "type": "string" } },
          "statute": { "type": ["string", "null"] },
          "case_law": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "cite": { "type": "string" },
                "holding": { "type": "string" }
              }
            }
          },
          "openness": { "type": "string", "enum": ["bright_line", "fact_dependent", "open_textured"] },
          "review_weight": { "type": "string", "enum": ["automated_ok", "human_required", "specialist_required"] },
          "note": { "type": ["string", "null"] }
        }
      }
    },
    "procedural_defects": {
      "type": "array",
      "description": "Module 5 — filing-stage defects in the unlawful-detainer complaint/summons, distinct from pre-filing notice defects.",
      "items": {
        "type": "object",
        "required": ["defect", "consequence"],
        "properties": {
          "defect": { "type": "string" },
          "consequence": { "type": "string" },
          "statute": { "type": ["string", "null"] },
          "case_law": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "cite": { "type": "string" },
                "holding": { "type": "string" }
              }
            }
          },
          "note": { "type": ["string", "null"] }
        }
      }
    }
  },
  "definitions": {
    "notice_period": {
      "type": "object",
      "properties": {
        "days": {
          "type": ["integer", "null"],
          "minimum": 1,
          "description": "Notice period in days. null when no notice is required (use with notice_required=false on parent pay_or_quit). minimum:1 applies only when value is an integer."
        },
        "statute": { "type": "string" },
        "count_method": { "type": "string", "enum": ["calendar_days", "business_days", "calendar_days_excluding_weekends_holidays"] }
      }
    },
    "module_status_entry": {
      "type": "object",
      "required": ["status", "reviewer", "reviewed_date"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["DRAFT", "AUTOMATED-CHECKS-PASSED", "UNDER REVIEW", "VALIDATED", "CERTIFIED", "NEEDS UPDATE"]
        },
        "reviewer": { "type": ["string", "null"], "description": "Name of attorney reviewer; null for DRAFT and AUTOMATED-CHECKS-PASSED" },
        "reviewed_date": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "coverage_level": { "type": ["string", "null"], "description": "For AUTOMATED-CHECKS-PASSED: which layers were applied, e.g. L1,L3,L5" }
      }
    }
  }
}
